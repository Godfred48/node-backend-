<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <p>Browse the kinds of service projects our partner organizations run:</p>

    <% if (categories.length === 0) { %>
        <p>No categories found.</p>
    <% } else { %>
        <ul class="category-list">
            <% categories.forEach(category => { %>
                <li><a href="/category/<%= category.category_id %>"><%= category.category_name %></a></li>
            <% }); %>
        </ul>
    <% } %>
</main>

<%- include('partials/footer') %>