<%- include('partials/header') %>

<main>
    <h1><%= project.title %></h1>

    <article class="project-details">
        <p class="project-org">
            Sponsored by:
            <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
        </p>

        <ul class="project-meta">
            <li><strong>Date:</strong> <%= new Date(project.project_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></li>
            <li><strong>Location:</strong> <%= project.project_location %></li>
            <li><strong>Category:</strong> <%= project.category_name %></li>
            
        </ul>

        <h2>About this project</h2>
        <p class="project-desc"><%= project.description %></p>

        <p><a href="/projects">&larr; Back to all projects</a></p>
    </article>
</main>

<%- include('partials/footer') %>