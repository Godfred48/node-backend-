<%- include('partials/header') %>

<main>
    <h1><%= category.category_name %></h1>
    <h2>Service Projects in this Category</h2>

    <% if (projects.length === 0) { %>
        <p>No service projects have been added to this category yet.</p>
    <% } else { %>
        <div class="projects-grid">
            <% projects.forEach(project => { %>
                <article class="project-card">
                    <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
                    <p class="project-org">
                        <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
                    </p>
                    <ul class="project-meta">
                        <li><strong>Location:</strong> <%= project.project_location %></li>
                        <li><strong>Date:</strong> <%= new Date(project.project_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></li>
                    </ul>
                </article>
            <% }); %>
        </div>
    <% } %>

    <p><a href="/categories">&larr; Back to all categories</a></p>
</main>

<%- include('partials/footer') %>